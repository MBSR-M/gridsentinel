{
  "uid": "gs-queue-health",
  "title": "GridSentinel | Background Queue Health",
  "description": "Durable job states in MySQL. These counts are not RabbitMQ queue-depth measurements. Exhausted jobs remain visible.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "gridsentinel",
    "pilot",
    "tenant-isolated"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Jobs by queue and state",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT queue,status,durable_jobs,max_attempt_number,expired_leases,oldest_created_at FROM v_queue_health ORDER BY queue,status LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Exhausted jobs",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT SUM(exhausted_jobs) AS exhausted_jobs FROM v_queue_health",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Expired running leases",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT SUM(expired_leases) AS expired_leases FROM v_queue_health",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    }
  ],
  "links": [
    {
      "title": "GridSentinel Admin",
      "type": "link",
      "url": "http://localhost:8080",
      "targetBlank": true
    }
  ]
}
