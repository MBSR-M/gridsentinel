{
  "uid": "gs-region-health",
  "title": "GridSentinel | Regional Operations",
  "description": "Aggregate region health. No consumer mappings or meter coordinates are exposed.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "gridsentinel",
    "pilot",
    "tenant-isolated"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Meters by region and status",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT region_name,health_status,meter_count,communication_score,observed_at FROM v_region_health ORDER BY region_name,health_status LIMIT 500",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Offline meters by region",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT region_name,SUM(meter_count) AS offline_meters FROM v_region_health WHERE health_status='OFFLINE' GROUP BY region_name ORDER BY offline_meters DESC LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "title": "Regions with observations",
      "type": "stat",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT region_name) AS regions FROM v_region_health",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    }
  ],
  "links": [
    {
      "title": "GridSentinel Admin",
      "type": "link",
      "url": "http://localhost:8080",
      "targetBlank": true
    }
  ]
}
