{
  "uid": "gs-platform-health",
  "title": "GridSentinel | Platform Health",
  "description": "Persisted worker heartbeats. Broker metrics remain absent until a worker records them. Heartbeat age indicates stale observations.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "gridsentinel",
    "pilot",
    "tenant-isolated"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Service heartbeat status",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT service_name,instance_id,status,observed_at,heartbeat_age_seconds FROM v_platform_health ORDER BY service_name LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Recorded consumer lag",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT service_name,instance_id,observed_kafka_lag,processed_events,invalid_events FROM v_platform_health WHERE observed_kafka_lag IS NOT NULL ORDER BY service_name LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "title": "Dropped buffered debug logs",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "gs-reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "gs-reporting"
          },
          "rawQuery": true,
          "rawSql": "SELECT service_name,instance_id,dropped_debug_logs FROM v_platform_health ORDER BY service_name LIMIT 100",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
  "links": [
    {
      "title": "GridSentinel Admin",
      "type": "link",
      "url": "http://localhost:8080",
      "targetBlank": true
    }
  ]
}
